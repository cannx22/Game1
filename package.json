{
  "name": "civciv-kiyameti",
  "version": "1.0.0",
  "description": "Civciv Kıyameti - çiftlikte geçen çok oyunculu gizli hain oyunu",
  "author": "Civciv Kıyameti",
  "type": "module",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node tests/flow-test.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.civcivkiyameti.oyun",
    "productName": "Civciv Kiyameti",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "client/**/*",
      "package.json",
      "!node_modules/three/examples/**",
      "!node_modules/three/src/**"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Civciv Kiyameti",
      "artifactName": "CivcivKiyameti-Kurulum-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
